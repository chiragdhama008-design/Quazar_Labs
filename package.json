{
  "name": "quazar-labs",
  "version": "1.0.0",
  "description": "Quazar Labs — Immersive Space-Themed Learning Platform",
  "main": "dist/server/server/src/index.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/server/src/index.js",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiragdhama008-design/Quazar_Labs.git"
  },
  "keywords": [
    "quazar-labs",
    "space-themed",
    "learning-platform",
    "nptel",
    "workshops",
    "education"
  ],
  "author": "Quazar Labs",
  "license": "ISC",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@prisma/client": "6.19.3",
    "clsx": "^2.1.1",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "^14.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.59.0",
    "marked": "^18.1.1",
    "pg": "^8.23.1",
    "pglite-prisma-adapter": "^0.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
